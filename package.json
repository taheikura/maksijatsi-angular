{
  "name": "maksijatsi-angular",
  "version": "0.0.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "echo 'No unit tests - see e2e tests'",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "format": "prettier --write \"src/**/*.{ts,html,scss,css,json}\" \"cypress/**/*.{ts,js,json}\" \"*.{json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,css,json}\" \"cypress/**/*.{ts,js,json}\" \"*.{json,md}\"",
    "code-quality": "npm run lint && npm run format:check",
    "code-quality:fix": "npm run lint:fix && npm run format",
    "sandbox": "npx ampx sandbox",
    "deletesandbox": "npx ampx sandbox delete",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=20"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.2.3",
    "@angular/cdk": "^20.2.1",
    "@angular/common": "^20.2.3",
    "@angular/compiler": "^20.2.3",
    "@angular/core": "^20.2.3",
    "@angular/forms": "^20.2.3",
    "@angular/material": "^20.2.1",
    "@angular/platform-browser": "^20.2.3",
    "@angular/platform-browser-dynamic": "^20.2.3",
    "@angular/router": "^20.2.3",
    "@aws-amplify/plugin-types": "^1.11.0",
    "@aws-amplify/ui-angular": "~5.1.3",
    "@ng-web-apis/canvas": "^4.12.0",
    "@ng-web-apis/common": "^4.12.0",
    "@types/three": "^0.172.0",
    "angular-three": "^4.0.0-next.115",
    "aws-amplify": "~6.15.5",
    "cannon-es": "^0.20.0",
    "rxjs": "~7.8.2",
    "three": "^0.172.0",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.2.1",
    "@angular/cli": "^20.2.1",
    "@angular/compiler-cli": "^20.2.1",
    "@aws-amplify/backend": "~1.1.0",
    "@aws-amplify/backend-cli": "~1.1.0",
    "@types/aws-lambda": "^8.10.149",
    "@types/jasmine": "~5.1.8",
    "angular-eslint": "20.2.0",
    "aws-cdk": "~2.1027.0",
    "aws-cdk-lib": "^2.152.0",
    "constructs": "^10.4.2",
    "cypress": "^15.0.0",
    "esbuild": "^0.25.4",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "jasmine-core": "~5.7.1",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "lint-staged": "^16.1.6",
    "prettier": "^3.6.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "8.40.0"
  },
  "volta": {
    "node": "20.19.0"
  },
  "resolutions": {
    "@aws-sdk/types": "3.862.0"
  },
  "overrides": {
    "@aws-sdk/types": "3.862.0"
  },
  "lint-staged": {
    "src/**/*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{html,scss,css}": [
      "prettier --write"
    ],
    "cypress/**/*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
